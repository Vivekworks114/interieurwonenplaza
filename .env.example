# Copy to .env.astropayload for local Payload sync:
#   cp .env.example .env.astropayload
#
# Required for: npm run sync:content

TENANT=interieurwonenplaza
PAYLOAD_URL=https://your-payload-host.example
PAYLOAD_API_KEY=

# Absolute path to the astropayload monorepo (contains packages/tenant-cli)
ASTROPAYLOAD_PLATFORM_ROOT=

# Public media base (absolutize /media paths + OG-safe URLs at build time)
PUBLIC_PAYLOAD_URL=https://your-payload-host.example
# R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Tenant slug used to repair bare R2 URLs → …/tenants/<slug>/<file>
PUBLIC_TENANT_SLUG=interieurwonenplaza
