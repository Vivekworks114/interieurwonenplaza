---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  date?: string;
  author?: string;
}

const { title, description, image, date, author } = Astro.props;
---
<BaseLayout title={title} description={description} image={image}>
  <slot name="header" slot="header" />
  <article class="article-page section">
    <div class="container article-page__inner reveal">
      {image && (
        <div class="article-page__hero">
          <img src={image} alt={title} width="1140" height="640" loading="eager" />
        </div>
      )}
      <header class="article-page__header">
        <h1>{title}</h1>
        {(date || author) && (
          <p class="article-page__meta">
            {author && <span>{author}</span>}
            {author && date && <span aria-hidden="true"> | </span>}
            {date && (
              <time datetime={date}>
                {new Date(date).toLocaleDateString('nl-NL', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                })}
              </time>
            )}
          </p>
        )}
      </header>
      <div class="prose article-page__content">
        <slot />
      </div>
    </div>
  </article>
  <slot name="footer" slot="footer" />
</BaseLayout>

<style>
  .article-page__inner {
    max-width: var(--container-max);
  }

  .article-page__hero {
    margin-bottom: 2rem;
    border-radius: var(--card-radius);
    overflow: hidden;
  }

  .article-page__hero img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .article-page__header h1 {
    margin-bottom: 0.5rem;
  }

  .article-page__meta {
    font-size: 0.875rem;
    color: var(--color-muted);
    margin-bottom: 2rem;
  }

  .article-page__content {
    max-width: 48rem;
  }
</style>
