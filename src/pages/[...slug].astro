---
import { getCollection, render } from 'astro:content';
import { allSiteSlugs, getPage } from '../data/pages';
import BlogPostLayout from '../layouts/BlogPostLayout.astro';
import ArticleLayout from '../layouts/ArticleLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  const pageEntries = await getCollection('pages');

  const blogPaths = blogEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { type: 'blog' as const, entry },
  }));

  const pagePaths = pageEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { type: 'page' as const, entry },
  }));

  const covered = new Set([
    ...blogEntries.map((e) => e.id),
    ...pageEntries.map((e) => e.id),
    'contact',
    'blogs',
    'blog',
    'home',
    'sitemap',
    'over-ons',
  ]);

  const legacyPaths = allSiteSlugs
    .filter((slug) => !covered.has(slug))
    .map((slug) => ({
      params: { slug },
      props: { type: 'legacy' as const, slug },
    }));

  return [...blogPaths, ...pagePaths, ...legacyPaths];
}

const props = Astro.props;

function createFallbackPage(slug: string) {
  const title = slug
    .replace(/^beste-/, '')
    .split('-')
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(' ');

  const isProduct = slug.startsWith('beste-');

  return {
    slug,
    title: isProduct ? `Beste ${title}` : title,
    description: `Lees alles over ${title.toLowerCase()} op InterieurWonenPlaza.nl.`,
    featuredImage: '/images/2023/01/kitchen-living-room-gddb814170_1920.jpg',
    content: `<p>Op InterieurWonenPlaza.nl vind je uitgebreide reviews en tips over ${title.toLowerCase()}. Bekijk onze vergelijkingen en koop de beste producten voor in huis.</p>`,
  };
}

const legacyPage =
  props.type === 'legacy'
    ? getPage(props.slug) ?? createFallbackPage(props.slug)
    : null;

const { Content } =
  props.type === 'blog' || props.type === 'page'
    ? await render(props.type === 'blog' ? props.entry : props.entry)
    : { Content: null };
---
{props.type === 'blog' && Content && (
  <BlogPostLayout entry={props.entry}>
    <Header slot="header" />
    <Content />
    <Footer slot="footer" />
  </BlogPostLayout>
)}

{props.type === 'page' && Content && (
  <ArticleLayout
    title={props.entry.data.title}
    description={props.entry.data.description}
    image={props.entry.data.featuredImage}
  >
    <Header slot="header" />
    <Content />
    <Footer slot="footer" />
  </ArticleLayout>
)}

{props.type === 'legacy' && legacyPage && (
  <ArticleLayout
    title={legacyPage.title}
    description={legacyPage.description}
    image={legacyPage.featuredImage}
  >
    <Header slot="header" />
    {legacyPage.content ? (
      <div set:html={legacyPage.content} />
    ) : (
      <p>{legacyPage.description}</p>
    )}
    <Footer slot="footer" />
  </ArticleLayout>
)}
