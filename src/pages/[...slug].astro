---
import { getCollection, render } from 'astro:content';
import { allSiteSlugs, getPage } from '../data/pages';
import BlogPostLayout from '../layouts/BlogPostLayout.astro';
import ElementorPageLayout from '../layouts/ElementorPageLayout.astro';
import ArticleLayout from '../layouts/ArticleLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const liveHtmlModules = import.meta.glob<string>(
  '../data/page-html/*.html',
  { query: '?raw', import: 'default', eager: true }
);

function getLiveHtml(slug: string): string | undefined {
  return liveHtmlModules[`../data/page-html/${slug}.html`];
}

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  const pageEntries = await getCollection('pages');

  const blogPaths = blogEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { type: 'blog' as const, entry },
  }));

  const pagePaths = pageEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { type: 'page' as const, entry },
  }));

  const covered = new Set([
    ...blogEntries.map((e) => e.id),
    ...pageEntries.map((e) => e.id),
    'contact',
    'blogs',
    'blog',
    'home',
    'sitemap',
    'over-ons',
  ]);

  const legacyPaths = allSiteSlugs
    .filter((slug) => !covered.has(slug))
    .map((slug) => ({
      params: { slug },
      props: { type: 'legacy' as const, slug },
    }));

  return [...blogPaths, ...pagePaths, ...legacyPaths];
}

const props = Astro.props;

function createFallbackPage(slug: string) {
  const title = slug
    .replace(/^beste-/, '')
    .split('-')
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(' ');

  const isProduct = slug.startsWith('beste-');

  return {
    slug,
    title: isProduct ? `Beste ${title}` : title,
    description: `Lees alles over ${title.toLowerCase()} op InterieurWonenPlaza.nl.`,
    featuredImage: '/images/2023/01/kitchen-living-room-gddb814170_1920.jpg',
    content: `<p>Op InterieurWonenPlaza.nl vind je uitgebreide reviews en tips over ${title.toLowerCase()}. Bekijk onze vergelijkingen en koop de beste producten voor in huis.</p>`,
  };
}

const legacySlug = props.type === 'legacy' ? props.slug : null;
const legacyPage = legacySlug ? getPage(legacySlug) ?? createFallbackPage(legacySlug) : null;
const legacyLiveHtml = legacySlug ? getLiveHtml(legacySlug) : undefined;

const isProductPage =
  props.type === 'page' && props.entry.data.pageType === 'product';

const liveHtml =
  props.type === 'blog'
    ? getLiveHtml(props.entry.id)
    : props.type === 'page' && isProductPage
      ? getLiveHtml(props.entry.id)
      : legacyLiveHtml;

const useLiveHtml =
  props.type === 'blog'
    ? Boolean(props.entry.data.useLiveHtml && liveHtml)
    : props.type === 'page'
      ? Boolean(isProductPage && liveHtml)
      : Boolean(legacySlug?.startsWith('beste-') && liveHtml);

const liveHtmlTitle =
  props.type === 'blog'
    ? props.entry.data.title
    : props.type === 'page'
      ? props.entry.data.title
      : legacyPage?.title ?? '';

const liveHtmlDescription =
  props.type === 'blog'
    ? props.entry.data.description
    : props.type === 'page'
      ? props.entry.data.description
      : legacyPage?.description ?? '';

const { Content } =
  props.type === 'blog' || (props.type === 'page' && !useLiveHtml)
    ? await render(props.type === 'blog' ? props.entry : props.entry)
    : { Content: null };
---
{useLiveHtml && liveHtml && (
  <ElementorPageLayout
    title={liveHtmlTitle}
    description={liveHtmlDescription}
    html={liveHtml}
  >
    <Header slot="header" />
    <Footer slot="footer" />
  </ElementorPageLayout>
)}

{!useLiveHtml && props.type === 'blog' && Content && (
  <BlogPostLayout entry={props.entry}>
    <Header slot="header" />
    <Content />
    <Footer slot="footer" />
  </BlogPostLayout>
)}

{!useLiveHtml && props.type === 'page' && Content && (
  <ArticleLayout
    title={props.entry.data.title}
    description={props.entry.data.description}
    image={props.entry.data.featuredImage}
  >
    <Header slot="header" />
    <Content />
    <Footer slot="footer" />
  </ArticleLayout>
)}

{!useLiveHtml && props.type === 'legacy' && legacyPage && (
  <ArticleLayout
    title={legacyPage.title}
    description={legacyPage.description}
    image={legacyPage.featuredImage}
  >
    <Header slot="header" />
    {legacyPage.content ? (
      <div set:html={legacyPage.content} />
    ) : (
      <p>{legacyPage.description}</p>
    )}
    <Footer slot="footer" />
  </ArticleLayout>
)}
