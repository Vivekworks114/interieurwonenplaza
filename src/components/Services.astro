---
import { categoryLinks } from '../data/homepage';
---
<section class="categories reveal" id="blok1">
  <div class="container">
    <div class="categories__grid">
      {categoryLinks.map((item) => (
        <a href={item.href} class="categories__item">
          <img src={item.icon} alt="" width="72" height="72" loading="lazy" />
          <span>{item.label}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .categories {
    padding-block: clamp(2rem, 4vw, 3rem);
  }

  .categories__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .categories__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: clamp(1.5rem, 3vw, 2rem) 1rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--card-radius);
    text-align: center;
    transition: box-shadow var(--transition), transform var(--transition), border-color var(--transition);
  }

  .categories__item:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
    border-color: var(--color-accent);
  }

  .categories__item img {
    width: auto;
    height: 72px;
    object-fit: contain;
  }

  .categories__item span {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-heading);
  }

  .categories__item:hover span {
    color: var(--color-primary);
  }

  @media (max-width: 767px) {
    .categories__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 479px) {
    .categories__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
