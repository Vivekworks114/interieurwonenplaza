---
import { heroContent } from '../data/homepage';
const lines = heroContent.description.split('\n');
---
<section class="hero reveal">
  <div class="hero__media" aria-hidden="true">
    <img
      src={heroContent.backgroundImage}
      alt=""
      class="hero__media-image"
      width="1440"
      height="641"
      loading="eager"
      decoding="async"
    />
  </div>
  <div class="hero__overlay" aria-hidden="true"></div>
  <div class="hero__shape" aria-hidden="true"></div>
  <div class="container hero__inner">
    <div class="hero__grid">
      <div class="hero__content">
        <h1>{heroContent.title}</h1>
        {lines.map((line) => (
          <p>{line}</p>
        ))}
        <a href={heroContent.ctaHref} class="btn btn--primary btn--square">{heroContent.ctaLabel}</a>
      </div>
      <div class="hero__visual" aria-hidden="true"></div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background-color: var(--color-primary);
    padding: 124px 0 190px;
    margin-top: -57px;
    padding-top: calc(124px + 57px);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .hero__media-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Elementor "center left" = vertically centered, horizontally left */
    object-position: left center;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to right,
      rgba(33, 33, 33, 0.8) 0%,
      rgba(33, 33, 33, 0.8) 42%,
      rgba(33, 33, 33, 0.45) 58%,
      rgba(33, 33, 33, 0) 72%
    );
    pointer-events: none;
  }

  .hero__shape {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 72px;
    background: #ffffff;
    clip-path: polygon(-1px 0, calc(100% + 1px) 6px, calc(100% + 1px) 100%, -1px 100%);
    pointer-events: none;
    z-index: 3;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 1.25rem;
  }

  .hero__content {
    max-width: 34rem;
  }

  .hero__visual {
    min-height: 1px;
  }

  .hero__content h1 {
    color: var(--color-secondary);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .hero__content p {
    color: var(--color-text);
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 0.5rem;
  }

  .hero__content .btn {
    margin-top: 1.25rem;
  }

  @media (max-width: 1024px) {
    .hero {
      padding: 72px 0 120px;
      padding-top: calc(72px + 57px);
    }

    .hero__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 3fr);
    }
  }

  @media (max-width: 767px) {
    .hero {
      padding: 36px 0 120px;
      padding-top: calc(36px + 57px);
    }

    .hero__grid {
      grid-template-columns: 1fr;
    }

    .hero__visual {
      display: none;
    }

    .hero__media-image {
      object-position: 65% center;
    }

    .hero__overlay {
      background: linear-gradient(
        to bottom,
        rgba(33, 33, 33, 0.82) 0%,
        rgba(33, 33, 33, 0.72) 55%,
        rgba(33, 33, 33, 0.35) 100%
      );
    }
  }
</style>
