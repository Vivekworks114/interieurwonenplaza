---
import { ctaSection } from '../data/homepage';
---
<section
  class="cta-band reveal"
  style={`background-image: url('${ctaSection.backgroundImage}')`}
>
  <div class="cta-band__overlay" aria-hidden="true"></div>
  <div class="container cta-band__inner">
    <div class="cta-band__spacer" aria-hidden="true"></div>
    <div class="cta-band__content">
      <h2>{ctaSection.title}</h2>
      <a href={ctaSection.ctaHref} class="btn btn--primary">{ctaSection.ctaLabel}</a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    background-color: var(--color-primary);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    min-height: clamp(280px, 40vw, 380px);
    display: flex;
    align-items: center;
  }

  .cta-band__overlay {
    position: absolute;
    inset: 0;
    background: rgba(33, 33, 33, 0.75);
    pointer-events: none;
  }

  .cta-band__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 2rem;
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .cta-band__content h2 {
    color: var(--color-secondary);
    margin-bottom: 1.25rem;
  }

  @media (max-width: 767px) {
    .cta-band__inner {
      grid-template-columns: 1fr;
    }

    .cta-band__spacer {
      display: none;
    }
  }
</style>
