---
import type { Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from './Header.astro'
import Footer from './Footer.astro'
import BlogCard from './BlogCard.astro'
import BlogPagination from './BlogPagination.astro'

interface Props {
  page: Page<CollectionEntry<'blog'>>
  title: string
  description: string
  /** Base path without trailing slash, e.g. `/blogs` */
  basePath: string
}

const { page, title, description, basePath } = Astro.props
const total = page.total
---
<BaseLayout title={title} description={description}>
  <Header slot="header" />
  <section class="section">
    <div class="container reveal">
      <div class="section-header">
        <h1>{title}</h1>
        <p>{description}</p>
        {total > 0 && (
          <p class="blog-archive__count">
            {total} {total === 1 ? 'artikel' : 'artikelen'}
            {page.lastPage > 1 && ` · pagina ${page.currentPage} van ${page.lastPage}`}
          </p>
        )}
      </div>
      {page.data.length > 0 ? (
        <div class="card-grid">
          {page.data.map((post) => (
            <BlogCard entry={post} />
          ))}
        </div>
      ) : (
        <p>Er zijn nog geen blogartikelen gepubliceerd.</p>
      )}
      <BlogPagination
        currentPage={page.currentPage}
        lastPage={page.lastPage}
        url={page.url}
        basePath={basePath}
      />
    </div>
  </section>
  <Footer slot="footer" />
</BaseLayout>

<style>
  h1 {
    font-size: clamp(2rem, 4vw, 2.5rem);
  }

  .blog-archive__count {
    margin: 0.75rem 0 0;
    font-size: 0.875rem;
    color: var(--color-muted);
  }
</style>
